# Shams.ma — Environment Variables (draft, Session 1)
# Real values to be collected from user before EXECUTE (Session 2+). Never commit .env.

# --- Database (PostgreSQL + PostGIS) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shamsma
DB_USER=
DB_PASSWORD=

# --- Auth (JWT) ---
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Payments (CMI — Morocco card gateway, booking deposits) ---
CMI_MERCHANT_ID=
CMI_API_KEY=
CMI_SECRET=

# --- Geocoding / Maps (for installer coverage-zone matching) ---
GEOCODING_API_KEY=

# --- Email (transactional: quote requests, verification) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- File storage (installer certification uploads) ---
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=
FILE_STORAGE_BUCKET=

# --- Server ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
