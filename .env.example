# Shams.ma — Environment Variables (template). Copy to .env and fill in. Never commit .env.

# --- Database (PostgreSQL + PostGIS) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shamsma
DB_USER=postgres
DB_PASSWORD=postgres

# --- Auth (JWT, RS256 per Security doc section 3) ---
# Generate a local dev keypair: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#   -out backend/src/main/resources/keys/private.pem && openssl rsa -pubout \
#   -in backend/src/main/resources/keys/private.pem -out backend/src/main/resources/keys/public.pem
JWT_PRIVATE_KEY_PATH=classpath:keys/private.pem
JWT_PUBLIC_KEY_PATH=classpath:keys/public.pem

# --- Payments (CMI — Morocco card gateway, booking deposits) ---
# Local dev: use CMI sandbox/test credentials. Production: real merchant creds from CMI onboarding.
CMI_MERCHANT_ID=
CMI_API_KEY=
CMI_SECRET=

# --- Geocoding / Maps (for installer coverage-zone matching) ---
# Local dev default: Nominatim (OpenStreetMap) — free, no key required.
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=

# --- Email (transactional: quote requests, verification) ---
# Local dev default: Mailhog SMTP catcher (docker: mailhog/mailhog).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# --- File storage (installer certification uploads) ---
# Local dev default: MinIO (docker: minio/minio), S3-compatible.
FILE_STORAGE_ENDPOINT=http://localhost:9000
FILE_STORAGE_ACCESS_KEY=minioadmin
FILE_STORAGE_SECRET_KEY=minioadmin
FILE_STORAGE_BUCKET=shamsma-certs-dev

# --- Server ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
